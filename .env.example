# RedLine GIS - Community Project Payments (Netanya: Poleg & Ir Yamim)
# Environment Variables Configuration Template
# ------------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' (or set these environment variables in your hosting provider:
#    Vercel Project Settings -> Environment Variables, or Netlify Site configuration -> Build & deploy -> Environment).
# 2. For local static development, you can also set these variables in 'env-config.js'
#    or input them directly into the in-app Supabase Connection Settings dialog.
# ------------------------------------------------------------------------------

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Anonymous Public API Key (Project Settings -> API -> anon public key)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Passcode required to unlock Admin Mode (defaults to KavAdom1 if left blank)
VITE_ADMIN_PASSCODE="KavAdom1"
